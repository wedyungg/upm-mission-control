# ============================================================
# Dashboard UPM — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Supabase (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth 2.0 (https://console.cloud.google.com)
# Create a Web App credential and add your domain as redirect URI
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Drive root folder name
GOOGLE_DRIVE_FOLDER=Dashboard UPM
